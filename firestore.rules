rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Users ──────────────────────────────────────────────────────────────
    match /users/{uid} {
      // Fix: Allow authenticated users to 'get' profiles so team members
      // can verify their owner's activation status.
      allow get: if request.auth != null;
      
      // Allow authenticated users to search/list profiles (needed for invites)
      allow list: if request.auth != null;
        
      allow write: if request.auth != null && request.auth.uid == uid;

      // Notifications sub-collection: user can read/delete their own
      match /notifications/{notifId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        // Anyone authenticated can create a notification (e.g. invite) for another user
        allow create: if request.auth != null;
      }
    }

    // ─── Teams ──────────────────────────────────────────────────────────────
    match /teams/{teamId} {
      // Members can read their team; owner can read, update, delete
      allow read: if request.auth != null &&
        (request.auth.token.email in resource.data.members || 
         request.auth.uid == resource.data.ownerId ||
         request.auth.uid in resource.data.memberUids);
         
      allow create: if request.auth != null;
      
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.ownerId || 
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberUids', 'pendingInvites']) &&
          (
            // Join case: Add self
            (request.auth.token.email in request.resource.data.members && 
             request.auth.uid in request.resource.data.memberUids &&
             resource.data.members.size() < 4) ||
            // Leave case: Remove self
            (request.auth.token.email in resource.data.members && 
             !(request.auth.token.email in request.resource.data.members)) ||
            // Decline invite case (only modifying pendingInvites)
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingInvites'])
          )));
          
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.ownerId;

      // Call logs sub-collection (legacy): team members and owner can read/write
      match /call_logs/{logId} {
        allow read, create: if request.auth != null &&
          (request.auth.token.email in get(/databases/$(database)/documents/teams/$(teamId)).data.members ||
           request.auth.uid == get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId ||
           request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.memberUids);
      }
      
      // Activity logs sub-collection: team members and owner can read/write
      match /activity_logs/{logId} {
        allow read, create: if request.auth != null &&
          (request.auth.token.email in get(/databases/$(database)/documents/teams/$(teamId)).data.members ||
           request.auth.uid == get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId ||
           request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.memberUids);
      }
      
      // Templates sub-collection: team members and owner can read/write
      match /templates/{templateId} {
        allow read, write: if request.auth != null &&
          (request.auth.token.email in get(/databases/$(database)/documents/teams/$(teamId)).data.members ||
           request.auth.uid == get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId ||
           request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.memberUids);
      }
    }

    // ─── Leads ──────────────────────────────────────────────────────────────
    match /leads/{leadId} {
      // Helper functions
      function isTeamMember() {
        let teamId = resource.data.teamId != null ? resource.data.teamId : request.resource.data.teamId;
        return teamId != null &&
          (request.auth.token.email in get(/databases/$(database)/documents/teams/$(teamId)).data.members ||
           request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.memberUids);
      }

      function isOwner() {
        let teamId = resource.data.teamId != null ? resource.data.teamId : request.resource.data.teamId;
        return teamId != null &&
          request.auth.uid == get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId;
      }

      // Read: own leads, team member, or owner
      allow read, list: if request.auth != null &&
        (resource.data.addedBy == request.auth.uid || isTeamMember() || isOwner());

      // Create: any authenticated user can create a lead
      allow create: if request.auth != null &&
        request.resource.data.addedBy == request.auth.uid;

      // Update: own leads, team members, or owner
      allow update: if request.auth != null &&
        (resource.data.addedBy == request.auth.uid || isTeamMember() || isOwner());

      // Delete: only the creator or team owner can delete
      allow delete: if request.auth != null &&
        (resource.data.addedBy == request.auth.uid || isOwner());
    }

    // ─── Activation Codes ───────────────────────────────────────────────────
    match /activation_codes/{codeId} {
      // Anyone can get a specific code to verify its existence
      allow get: if request.auth != null;
      // Cannot list all codes
      allow list: if false;
      // Can only update if it is currently not used
      allow update: if request.auth != null && 
        resource.data.used == false && 
        request.resource.data.used == true;
      // Only admin (from console) should create/delete codes
      allow create, delete: if false;
    }
  }
}
